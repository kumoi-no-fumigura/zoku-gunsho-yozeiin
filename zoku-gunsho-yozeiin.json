 "blocks": [
  {
   "id": "zoku-gunsho-yozeiin-0001",
   "pid": "nao-734209",
   "pages": [
    2
   ],
   "text": "続群書類従巻第四百十二和歌部四十七陽成院歌合河原院歌合多武峯千代君歌合源大納言師房卿家歌合今元範永朝臣家十番歌合歌絵合総撿校保己一集男源忠宝校",
   "poems": []
  },
  {
   "id": "zoku-gunsho-yozeiin-0002",
   "pid": "nao-734209",
   "pages": [
    3
   ],
   "text": "伏見院金玉歌合為兼卿頓阿勝負付歌合陽成院歌合夏虫戀一番持左いたつらに身はなること夏虫の思ひはえこそ雉れさりけり身をすてゝひとつ思ひにこかれたる心そ暮の虫にまされる右二番左",
   "poems": [
    "1",
    "2"
   ]
  },
  {
   "id": "zoku-gunsho-yozeiin-0003",
   "pid": "nao-734209",
   "pages": [
    4
   ],
   "text": "〽おもひをはいかにしれはか夏虫のもゆる中にもいりまとふらん恋ずとそみすいたつらにならはなれ我なら虫に成やしなまし右三番〽おのゝかみをはおもへと夏虫のかゝる思ひはえこそはなれね左こひによりみのうせむをはみゆれともなを夏むしのなをやたちなん七四番左こび〳〵てたゝにやゝまむ夢虫の思ひのほうらみをやすてゝむお狗よりひとつ思ひにみをすてゝ今年も夏の虫となりしよ五番左身を捨ておもひここ夏むしのいまいくすみあらしとそおもふ身を捨ておもひか右多をへてこひにみなるゝ夏虫のあふにはかへていかゝなりにし六番左",
   "poems": [
    "3",
    "4",
    "5",
    "6",
    "7",
    "8",
    "9",
    "10"
   ]
  },
  {
   "id": "zoku-gunsho-yozeiin-0004",
   "pid": "nao-734209",
   "pages": [
    5
   ],
   "text": "逢ことをいつとも知ぬなつ虫の思はかりなくやあるらんから〳〵にみをそ折つる夏虫のなをあきたらぬこひをたのみて右七番左あひみたることもなくては夏虫のいかてか思身みなれむ身のならむことをはしらて夏虫の中なるこひにそ思いたらんな八番左衛門かきりなき思ひのほかに夏むしのまとふを人のうへとこそみ右たゝひとや思ひをここ夏むしのいのちをすてゝ頼むなるらん九番左思ひにそみをも未欠右あひもみしこひにしよりてなつむしのもえこかることかひむりける十番左",
   "poems": [
    "11",
    "12",
    "13",
    "14",
    "15",
    "16",
    "17"
   ]
  },
  {
   "id": "zoku-gunsho-yozeiin-0005",
   "pid": "nao-734209",
   "pages": [
    6
   ],
   "text": "一みみりまたおもひのことに夏虫のなれてすへにもたのむなくにす夏虫のわかたましひにみをかつくし心とことにこかれけるかなお九月五日庚申夜河原院歌合廿首一番霜鶴立洲左あしたつのたてるなきさのかはへにはちよをかす右かつ一見えてみき有にたてかたつはみなかへこるよを思なるへし二番翠松臨池左かつも伊け水に松のみとりのそめぬれはいとゝふかさのそこもしられす",
   "poems": [
    "18",
    "19",
    "20",
    "21",
    "22"
   ]
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "いたつらに身はなること夏虫の思ひはえこそ雉れさりけり",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "2",
   "text": "身をすてゝひとつ思ひにこかれたる心そ暮の虫にまされる",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "",
   "dai": ""
  },
  {
   "seq": "3",
   "text": "〽おもひをはいかにしれはか夏虫のもゆる中にもいりまとふらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "4",
   "text": "恋ずとそみすいたつらにならはなれ我なら虫に成やしなまし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "",
   "dai": ""
  },
  {
   "seq": "5",
   "text": "〽おのゝかみをはおもへと夏虫のかゝる思ひはえこそはなれね",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "",
   "dai": ""
  },
  {
   "seq": "6",
   "text": "こひによりみのうせむをはみゆれともなを夏むしのなをやたちなん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "7",
   "text": "こび〳〵てたゝにやゝまむ夢虫の思ひのほうらみをやすてゝむ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "8",
   "text": "狗よりひとつ思ひにみをすてゝ今年も夏の虫となりしよ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "",
   "dai": ""
  },
  {
   "seq": "9",
   "text": "身を捨ておもひここ夏むしのいまいくすみあらしとそおもふ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "10",
   "text": "多をへてこひにみなるゝ夏虫のあふにはかへていかゝなりにし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "11",
   "text": "逢ことをいつとも知ぬなつ虫の思はかりなくやあるらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "12",
   "text": "から〳〵にみをそ折つる夏虫のなをあきたらぬこひをたのみて",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "",
   "dai": ""
  },
  {
   "seq": "13",
   "text": "あひみたることもなくては夏虫のいかてか思身みなれむ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "14",
   "text": "身のならむことをはしらて夏虫の中なるこひにそ思いたらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "",
   "dai": ""
  },
  {
   "seq": "15",
   "text": "かきりなき思ひのほかに夏むしのまとふを人のうへとこそみ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "左",
   "dai": "衛門"
  },
  {
   "seq": "16",
   "text": "たゝひとや思ひをここ夏むしのいのちをすてゝ頼むなるらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "右",
   "dai": "衛門"
  },
  {
   "seq": "17",
   "text": "あひもみしこひにしよりてなつむしのもえこかることかひむりける",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "18",
   "text": "一みみりまたおもひのことに夏虫のなれてすへにもたのむなくにす",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "19",
   "text": "夏虫のわかたましひにみをかつくし心とことにこかれけるかな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": ""
  },
  {
   "seq": "20",
   "text": "あしたつのたてるなきさのかはへにはちよをかす",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "21",
   "text": "一見えてみき有にたてかたつはみなかへこるよを思なるへし",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "右",
   "dai": "かつ"
  },
  {
   "seq": "22",
   "text": "伊け水に松のみとりのそめぬれはいとゝふかさのそこもしられす",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734209",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "左",
   "dai": "かつ"
  }
 ],
